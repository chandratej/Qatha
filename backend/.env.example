PORT=3001
NODE_ENV=development

# Demo mode — serves seed Telugu stories without Supabase (auto-enabled if no credentials)
MOCK_MODE=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Firebase (Phone OTP + FCM)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# DEV-003 — Revenue split (founder decision: 60/40)
CREATOR_SHARE_PCT=60

# DEV-004 — Configurable launch paywall (no code change to switch modes)
# immediate              → Ch 6 paywall, no launch trial
# seven_day_unlimited    → 7-day full access after OTP signup (MVP doc)
# three_month_unlimited  → 90-day founding member trial, first 500 signups (research)
LAUNCH_OFFER_MODE=immediate
# Optional overrides:
# LAUNCH_OFFER_TRIAL_DAYS=90
# LAUNCH_OFFER_FOUNDING_LIMIT=500
# LAUNCH_OFFER_SUBSCRIPTION_GATE_CHAPTER=6

# Perspective API (content moderation)
PERSPECTIVE_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000