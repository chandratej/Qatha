VITE_API_URL=http://localhost:3001/api

# === MOCK MODE (recommended for local dev / demo) ===
# Enable mock auth + no real Supabase required. Pairs with backend MOCK_MODE.
# When using placeholder values below, mock mode is auto-enabled.
# VITE_MOCK_MODE=true

# === QUICK SETUP: Copy this file to .env in the same folder ===
# cp .env.example .env   (or on Windows: copy .env.example .env)
#
# PURE SUPABASE AUTH per katha-auth-architecture-decision_auth.md
# Get from Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here