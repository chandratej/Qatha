VITE_API_URL=http://localhost:3001/api

# Reader gateway — shareable chapter links (Trojan Horse)
VITE_GATEWAY_URL=http://localhost:3002

# Skip register-device Edge Function (auto-skipped on localhost in dev; set true to force off)
# VITE_SKIP_DEVICE_REGISTER=true

# If Edge Functions are not deployed yet, publish falls back to Node API in dev (requires backend on :3001)
# Deploy: npx supabase functions deploy publish-chapter schedule-chapter review-chapter whatsapp-otp

# Enable slug + scheduled_publish_at columns after migrations 011–012 are applied
# VITE_SCHEMA_FEATURES=full

# === WAVE B: Supabase direct (auto-enabled when VITE_MOCK_MODE is not true) ===
# Set to false to keep using the interim Node API at VITE_API_URL during migration.
# VITE_USE_SUPABASE_DIRECT=true

# === WAVE 1: Platform API (peer reviews, tags) — auto-enabled when not in mock mode ===
VITE_USE_PLATFORM_API=true

# === MOCK MODE (demo only — omit or set false for production) ===
# VITE_MOCK_MODE=false
# Placeholder Supabase values below also enable mock mode unless VITE_MOCK_MODE=false.

# === QUICK SETUP: Copy this file to .env in the same folder ===
# cp .env.example .env   (or on Windows: copy .env.example .env)
#
# PURE SUPABASE AUTH per katha-auth-architecture-decision_auth.md
# Dashboard → Settings → API Keys → Publishable and secret API keys tab

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy (deprecated): VITE_SUPABASE_ANON_KEY=...

# Phone / WhatsApp (overrides platform_config.phone — see migration 013)
# VITE_PHONE_COUNTRY_CODE=91
# VITE_PHONE_NATIONAL_LENGTH=10
# VITE_PHONE_MOBILE_LEADING_PATTERN=[6-9]
VITE_PHONE_EXAMPLE_E164=+919492602026
# VITE_PHONE_REGION_LABEL=Indian
VITE_WHATSAPP_BUSINESS_NUMBER=+919492602026

# Studio Labs (Tags, Platform map only) — DEC-007; default off
# Reviewers + Events are core nav and do not require this flag
# VITE_STUDIO_LABS=false

# Observability (Cycle 7) — omit in local mock; set in production
# VITE_SENTRY_DSN=https://...@sentry.io/...
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# === WAVE C: Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets) ===
# RAZORPAY_KEY_SECRET=...        # payment-webhook signature verification
# OPENAI_API_KEY=...             # publish-chapter moderation gateway (optional; heuristic fallback)
# Production deploy checklist: docs/deploy/README.md (repo root docs/)
