PORT=3001
NODE_ENV=development

# Demo mode — serves seed Telugu stories without Supabase (auto-enabled if no credentials)
# Set false when real Supabase keys are configured (recommended for production)
MOCK_MODE=false

# Supabase (sole identity + data layer per katha-auth-architecture-decision_auth.md)
# Dashboard → Settings → API Keys → Publishable and secret API keys tab
SUPABASE_URL=https://your-project.supabase.co
# Optional: auto-apply migrations via scripts/init-database.ps1
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy JWT keys (deprecated — remove after migration):
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Phone / WhatsApp (overrides platform_config.phone — see migration 013)
# PHONE_COUNTRY_CODE=91
# PHONE_NATIONAL_LENGTH=10
# PHONE_MOBILE_LEADING_PATTERN=[6-9]
# PHONE_EXAMPLE_E164=+919876543210
# PHONE_REGION_LABEL=Indian
# WHATSAPP_BUSINESS_NUMBER=919876543210

# WhatsApp OTP — set in Supabase Edge Function secrets (whatsapp-otp):
# WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN, WHATSAPP_OTP_TEMPLATE, WHATSAPP_VERIFY_TOKEN
# See katha-auth-architecture-decision_auth.md — no Firebase Auth required.

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# DEV-003 — Revenue split (founder decision: 60/40)
CREATOR_SHARE_PCT=60

# DEV-004 — Configurable launch paywall (no code change to switch modes)
# immediate              → Ch 6 paywall, no launch trial
# seven_day_unlimited    → 7-day full access after OTP signup (MVP doc)
# three_month_unlimited  → 90-day founding member trial, first 500 signups (research)
LAUNCH_OFFER_MODE=immediate
# Optional overrides:
# LAUNCH_OFFER_TRIAL_DAYS=90
# LAUNCH_OFFER_FOUNDING_LIMIT=500
# LAUNCH_OFFER_SUBSCRIPTION_GATE_CHAPTER=6

# OpenAI Moderation API (content moderation gateway — free omni-moderation-latest)
OPENAI_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000