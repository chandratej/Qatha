{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd creator-cms && npm install",
  "buildCommand": "cd creator-cms && npm run build",
  "outputDirectory": "creator-cms/dist",
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
